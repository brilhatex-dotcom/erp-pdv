{
  "name": "@erp/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Contratos da API — fonte única do formato que trafega na rede",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
