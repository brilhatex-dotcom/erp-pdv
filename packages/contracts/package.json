    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@erp/config": "workspace:*",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
