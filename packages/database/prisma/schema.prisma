// Schema de persistência do ERP/PDV.
//
// Decisões que valem registro:
//
// • Dinheiro é BigInt de CENTAVOS, nunca Decimal ou Float. `Decimal` do Prisma
//   volta como objeto de biblioteca, e `Float` é o bug do fechamento de caixa.
//   BigInt mapeia direto para `int8` e casa com o `Dinheiro` do domínio.
// • Quantidade é BigInt de MILÉSIMOS, pelo mesmo motivo.
// • Chave primária é UUIDv7 gerado no cliente (ADR-0008): permite criar venda
//   offline e preserva localidade de índice, porque v7 começa pelo tempo.
// • Tabelas em snake_case plural; colunas em snake_case (CLAUDE.md §6).

generator client {
  provider = "prisma-client-js"
  output   = "../src/gerado"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Catálogo
// ─────────────────────────────────────────────────────────────────────────

enum TipoProduto {
  UNITARIO
  PESAVEL
}

model Produto {
  id                 String      @id @db.Uuid
  sku                String      @unique
  descricao          String      @db.VarChar(120)
  descricaoPdv       String      @map("descricao_pdv") @db.VarChar(40)
  /// Forma normalizada (sem acento, minúscula) usada na busca do balcão.
  descricaoBusca     String      @map("descricao_busca")
  tipo               TipoProduto
  unidadeBase        String      @map("unidade_base") @db.VarChar(6)
  /// Centavos.
  precoVenda         BigInt      @map("preco_venda")
  /// Centavos. Zero significa "não informado", não "de graça".
  custo              BigInt      @default(0)
  codigoBarras       String?     @unique @map("codigo_barras") @db.VarChar(14)
  /// Código do produto na balança, quando pesável.
  codigoBalanca      String?     @unique @map("codigo_balanca") @db.VarChar(7)
  categoriaId        String?     @map("categoria_id") @db.Uuid
  /// Opcional por decisão de arquitetura: com o módulo fiscal desligado o
  /// produto não tem tributação, e nada fora do fiscal depende disso (ADR-0016).
  perfilTributarioId String?     @map("perfil_tributario_id") @db.Uuid
  ativo              Boolean     @default(true)
  /// Milésimos, na unidade base. NULL significa "não acompanhar" — e não zero.
  estoqueMinimo      BigInt?     @map("estoque_minimo")
  /// Fornecedor de costume, para a lista de reposição.
  fornecedorId       String?     @map("fornecedor_id") @db.Uuid
  imagemId           String?     @map("imagem_id") @db.Uuid
  /// Aparece como botão no caixa: o pão, a banana, o refrigerante de sempre.
  botaoRapido        Boolean     @default(false) @map("botao_rapido")
  criadoEm           DateTime    @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime    @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  fornecedor Fornecedor? @relation(fields: [fornecedorId], references: [id])
  imagem     Imagem?     @relation(fields: [imagemId], references: [id])

  referencias     ReferenciaProduto[]
  embalagens      Embalagem[]
  movimentos      MovimentoEstoque[]
  saldo           SaldoEstoque?
  itensVenda      VendaItem[]
  itensDeCompra   ItemNotaCompra[]
  itensDevolvidos DevolucaoItem[]

  // Só produtos ativos aparecem na busca do PDV; o índice parcial mantém a
  // estrutura pequena e o plano previsível (RNF-02).
  @@index([descricaoBusca], map: "idx_produtos_busca")
  @@index([ativo], map: "idx_produtos_ativo")
  @@index([fornecedorId], map: "idx_produtos_fornecedor")
  @@map("produtos")
}

enum TipoReferencia {
  EAN
  FABRICANTE
  ORIGINAL
  SIMILAR
  INTERNO
  FORNECEDOR
}

/// Códigos alternativos: fabricante, original, similar. Essencial em autopeças,
/// onde o cliente traz o código escrito num papel.
model ReferenciaProduto {
  produtoId   String         @map("produto_id") @db.Uuid
  tipo        TipoReferencia
  valor       String         @db.VarChar(60)
  /// Sem separadores nem acento — é por aqui que a busca compara.
  normalizado String

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  // Chave natural: a referência só existe dentro do produto e não tem
  // identidade própria. Evita inventar UUID para linha filha — e o problema
  // de mantê-lo estável entre regravações.
  @@id([produtoId, tipo, normalizado])
  @@index([normalizado], map: "idx_referencias_normalizado")
  @@map("referencias_produto")
}

/// Fardo, caixa, palete — com o fator de conversão para a unidade base.
model Embalagem {
  produtoId    String  @map("produto_id") @db.Uuid
  unidade      String  @db.VarChar(6)
  /// Quantas unidades base a embalagem contém.
  fator        BigInt
  codigoBarras String? @map("codigo_barras") @db.VarChar(14)

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@id([produtoId, unidade])
  @@map("embalagens")
}

// ─────────────────────────────────────────────────────────────────────────
// Estoque
// ─────────────────────────────────────────────────────────────────────────

enum TipoMovimentoEstoque {
  ENTRADA
  DEVOLUCAO_CLIENTE
  ESTORNO_VENDA
  AJUSTE_POSITIVO
  TRANSFERENCIA_ENTRADA
  SAIDA
  PERDA
  DEVOLUCAO_FORNECEDOR
  AJUSTE_NEGATIVO
  TRANSFERENCIA_SAIDA
}

enum OrigemMovimentoEstoque {
  VENDA
  COMPRA
  DEVOLUCAO
  INVENTARIO
  TRANSFERENCIA
  MANUAL
}

/// Fato imutável. **Append-only**: correção gera movimento novo, nunca UPDATE.
model MovimentoEstoque {
  id                String                 @id @db.Uuid
  produtoId         String                 @map("produto_id") @db.Uuid
  tipo              TipoMovimentoEstoque
  /// Milésimos, sempre positivo. O sinal vem do tipo.
  quantidade        BigInt
  unidade           String                 @db.VarChar(6)
  origemTipo        OrigemMovimentoEstoque @map("origem_tipo")
  origemDocumentoId String?                @map("origem_documento_id") @db.Uuid
  usuarioId         String                 @map("usuario_id") @db.Uuid
  /// Centavos. Só preenchido em entrada de compra.
  custoUnitario     BigInt?                @map("custo_unitario")
  lote              String?                @db.VarChar(30)
  observacao        String?
  ocorridoEm        DateTime               @map("ocorrido_em") @db.Timestamptz(3)

  produto Produto @relation(fields: [produtoId], references: [id])

  // Consulta do extrato: movimentos de um produto em ordem cronológica.
  @@index([produtoId, ocorridoEm], map: "idx_movimentos_produto_data")
  @@index([origemDocumentoId], map: "idx_movimentos_origem")
  @@map("movimentos_estoque")
}

/// Projeção do saldo — **derivada**, nunca a fonte da verdade.
///
/// Materializada porque somar milhões de movimentos a cada bipada não caberia
/// no orçamento de 100 ms (RNF-02). Pode ser reconstruída a qualquer momento a
/// partir de `movimentos_estoque`.
model SaldoEstoque {
  produtoId    String   @id @map("produto_id") @db.Uuid
  /// Milésimos, com sinal. Negativo é possível e não é erro.
  milesimos    BigInt   @default(0)
  unidade      String   @db.VarChar(6)
  /// Centavos — custo médio ponderado móvel.
  custoMedio   BigInt   @default(0) @map("custo_medio")
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@map("saldos_estoque")
}

// ─────────────────────────────────────────────────────────────────────────
// Caixa
// ─────────────────────────────────────────────────────────────────────────

enum StatusCaixa {
  ABERTA
  FECHADA
}

model SessaoCaixa {
  id                String      @id @db.Uuid
  estacaoId         String      @map("estacao_id") @db.Uuid
  operadorId        String      @map("operador_id") @db.Uuid
  /// Centavos.
  fundoTroco        BigInt      @map("fundo_troco")
  status            StatusCaixa @default(ABERTA)
  abertaEm          DateTime    @map("aberta_em") @db.Timestamptz(3)
  fechadaEm         DateTime?   @map("fechada_em") @db.Timestamptz(3)
  /// Centavos, informado no fechamento.
  contadoEmDinheiro BigInt?     @map("contado_em_dinheiro")

  // Acumuladores da sessão. São derivados das vendas, mas ficam materializados
  // aqui pelo mesmo motivo de `saldos_estoque`: reabrir a gaveta não pode
  // depender de somar as 2.000 vendas do dia (RNF-01).
  /// Centavos — troco devolvido acumulado.
  trocoDevolvido          BigInt @default(0) @map("troco_devolvido")
  /// Centavos — total vendido na sessão.
  totalVendido            BigInt @default(0) @map("total_vendido")
  quantidadeVendas        Int    @default(0) @map("quantidade_vendas")
  /// Centavos — descontos das vendas que ficaram de pé.
  descontosConcedidos     BigInt @default(0) @map("descontos_concedidos")
  quantidadeCancelamentos Int    @default(0) @map("quantidade_cancelamentos")
  /// Centavos.
  totalCancelado          BigInt @default(0) @map("total_cancelado")
  quantidadeDevolucoes    Int    @default(0) @map("quantidade_devolucoes")
  /// Centavos — todas as devoluções do turno, em qualquer forma.
  totalDevolvido          BigInt @default(0) @map("total_devolvido")
  /// Centavos — a parte que saiu da gaveta em espécie.
  devolvidoEmDinheiro     BigInt @default(0) @map("devolvido_em_dinheiro")

  /// Chave estrangeira criada `NOT VALID` na migração `balcao_completo`: vale
  /// para toda sessão nova, sem reprovar a instalação por uma linha antiga.
  operador Usuario @relation("SessaoCaixaOperador", fields: [operadorId], references: [id])

  movimentos MovimentoCaixa[]
  recebidos  RecebimentoCaixa[]
  vendas     Venda[]
  devolucoes Devolucao[]

  // Só pode existir uma sessão aberta por estação — garantido por índice
  // parcial na migração, porque o Prisma não expressa índice condicional.
  @@index([estacaoId, status], map: "idx_sessoes_estacao_status")
  @@map("sessoes_caixa")
}

enum TipoMovimentoCaixa {
  SANGRIA
  SUPRIMENTO
}

model MovimentoCaixa {
  id              String             @id @db.Uuid
  sessaoCaixaId   String             @map("sessao_caixa_id") @db.Uuid
  tipo            TipoMovimentoCaixa
  /// Centavos.
  valor           BigInt
  motivo          String
  usuarioId       String             @map("usuario_id") @db.Uuid
  autorizadoPorId String?            @map("autorizado_por_id") @db.Uuid
  ocorridoEm      DateTime           @map("ocorrido_em") @db.Timestamptz(3)

  sessao SessaoCaixa @relation(fields: [sessaoCaixaId], references: [id])

  @@index([sessaoCaixaId], map: "idx_movimentos_caixa_sessao")
  @@map("movimentos_caixa")
}

/// Total recebido por forma de pagamento numa sessão.
///
/// A sessão guarda **totais**, não a lista de vendas: carregar 2.000 vendas
/// para abrir a gaveta quebraria a meta de resposta do PDV.
model RecebimentoCaixa {
  sessaoCaixaId String @map("sessao_caixa_id") @db.Uuid
  forma         String @db.VarChar(20)
  /// Centavos.
  valor         BigInt @default(0)

  sessao SessaoCaixa @relation(fields: [sessaoCaixaId], references: [id])

  @@id([sessaoCaixaId, forma])
  @@map("recebimentos_caixa")
}

// ─────────────────────────────────────────────────────────────────────────
// Vendas
// ─────────────────────────────────────────────────────────────────────────

enum StatusVenda {
  ABERTA
  FINALIZADA
  CANCELADA
}

model Venda {
  id            String      @id @db.Uuid
  /// Sequencial dentro da série da estação.
  numero        Int
  sessaoCaixaId String      @map("sessao_caixa_id") @db.Uuid
  operadorId    String      @map("operador_id") @db.Uuid
  estacaoId     String      @map("estacao_id") @db.Uuid
  clienteId     String?     @map("cliente_id") @db.Uuid
  status        StatusVenda @default(ABERTA)
  /// Centavos — desconto concedido sobre a venda inteira.
  descontoVenda BigInt      @default(0) @map("desconto_venda")
  /// Centavos — trocoDevolvido, gravado para conferência do caixa.
  troco         BigInt      @default(0)
  abertaEm      DateTime    @map("aberta_em") @db.Timestamptz(3)
  finalizadaEm  DateTime?   @map("finalizada_em") @db.Timestamptz(3)

  /// Venda guardada para depois. NULL quando está na frente do operador.
  suspensaEm      DateTime? @map("suspensa_em") @db.Timestamptz(3)
  rotuloSuspensao String?   @map("rotulo_suspensao") @db.VarChar(40)

  canceladaEm                 DateTime? @map("cancelada_em") @db.Timestamptz(3)
  motivoCancelamento          String?   @map("motivo_cancelamento") @db.VarChar(200)
  canceladaPorId              String?   @map("cancelada_por_id") @db.Uuid
  cancelamentoAutorizadoPorId String?   @map("cancelamento_autorizado_por_id") @db.Uuid

  sessao                    SessaoCaixa     @relation(fields: [sessaoCaixaId], references: [id])
  canceladaPor              Usuario?        @relation("VendaCanceladaPor", fields: [canceladaPorId], references: [id], onDelete: Restrict)
  cancelamentoAutorizadoPor Usuario?        @relation("VendaCancelamentoAutorizadoPor", fields: [cancelamentoAutorizadoPorId], references: [id], onDelete: Restrict)
  itens                     VendaItem[]
  pagamentos                Pagamento[]
  importada                 VendaImportada?
  devolucoes                Devolucao[]

  // Numeração fiscal é sequencial e sem lacuna POR ESTAÇÃO (uma série por PDV).
  @@unique([estacaoId, numero], map: "uq_vendas_estacao_numero")
  @@index([sessaoCaixaId], map: "idx_vendas_sessao")
  @@index([finalizadaEm], map: "idx_vendas_finalizada")
  @@map("vendas")
}

model VendaItem {
  vendaId         String  @map("venda_id") @db.Uuid
  /// Sequencial dentro da venda. Vira `nItem` no XML fiscal.
  numero          Int
  produtoId       String  @map("produto_id") @db.Uuid
  /// Congelada no momento da venda — não referencia o cadastro.
  descricao       String  @db.VarChar(120)
  /// Milésimos.
  quantidade      BigInt
  unidade         String  @db.VarChar(6)
  /// Centavos — congelado no momento da venda.
  precoUnitario   BigInt  @map("preco_unitario")
  /// Centavos — desconto dado neste item.
  desconto        BigInt  @default(0)
  /// Centavos — parcela do desconto da venda que coube a este item.
  descontoRateado BigInt  @default(0) @map("desconto_rateado")
  /// Centavos — custo da unidade **no instante da venda**. NULL quando a loja
  /// ainda não tinha custo nenhum: margem desconhecida, não margem cheia.
  custoUnitario   BigInt? @map("custo_unitario")

  venda   Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])

  @@id([vendaId, numero])
  @@index([produtoId], map: "idx_itens_produto")
  @@map("venda_itens")
}

model Pagamento {
  vendaId     String  @map("venda_id") @db.Uuid
  /// Ordem em que foi registrado — o PDV remove pelo índice.
  ordem       Int
  forma       String  @db.VarChar(20)
  /// Centavos.
  valor       BigInt
  autorizacao String? @db.VarChar(40)
  parcelas    Int     @default(1)
  /// Quem confirmou: MANUAL (operador), INTEGRACAO (TEF/PSP) ou SIMULADA
  /// (só no treinamento). CHECK na migração.
  confirmacao String  @default("MANUAL") @db.VarChar(12)
  /// Gerada pela estação antes do envio: o reenvio não duplica o pagamento.
  chave       String? @db.VarChar(64)

  venda Venda @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  @@id([vendaId, ordem])
  @@unique([vendaId, chave], map: "uq_pagamentos_venda_chave")
  @@map("pagamentos")
}

// ─────────────────────────────────────────────────────────────────────────
// Outbox
// ─────────────────────────────────────────────────────────────────────────

enum StatusOutbox {
  PENDENTE
  PROCESSANDO
  ENTREGUE
  FALHOU
}

/// Eventos a entregar, gravados na MESMA transação do dado que os originou.
///
/// É o que impede o pior defeito do fluxo de venda: a venda gravar e o evento
/// se perder, ou nota fiscal ser emitida para venda que a transação reverteu.
model EventoOutbox {
  id           String       @id @db.Uuid
  tipo         String       @db.VarChar(60)
  agregadoId   String       @map("agregado_id") @db.Uuid
  /// Corpo do evento em JSON. BigInt vai como texto, para não perder precisão.
  payload      Json
  status       StatusOutbox @default(PENDENTE)
  tentativas   Int          @default(0)
  ocorridoEm   DateTime     @map("ocorrido_em") @db.Timestamptz(3)
  processadoEm DateTime?    @map("processado_em") @db.Timestamptz(3)
  ultimoErro   String?      @map("ultimo_erro")

  // O worker busca pendentes em ordem de ocorrência.
  @@index([status, ocorridoEm], map: "idx_outbox_pendentes")
  @@map("eventos_outbox")
}

// ─────────────────────────────────────────────────────────────────────────
// Identidade e acesso
// ─────────────────────────────────────────────────────────────────────────

model Papel {
  id     String  @id @db.Uuid
  codigo String  @unique @db.VarChar(40)
  nome   String  @db.VarChar(60)
  /// Papel de fábrica: pode ser copiado, não excluído.
  padrao Boolean @default(false)

  // Limites por valor. Percentual em PONTOS-BASE (500 = 5%), pelo mesmo motivo
  // que dinheiro é centavo. NULL significa SEM TETO, e não zero — confundir os
  // dois liberaria a gaveta para quem não deveria.
  descontoMaximoItemBps    Int?    @map("desconto_maximo_item_bps")
  descontoMaximoVendaBps   Int?    @map("desconto_maximo_venda_bps")
  /// Centavos.
  valorMaximoSangria       BigInt? @map("valor_maximo_sangria")
  minutosParaCancelarVenda Int?    @map("minutos_para_cancelar_venda")
  /// Centavos.
  estornoMaximoEmDinheiro  BigInt? @map("estorno_maximo_em_dinheiro")

  permissoes PermissaoPapel[]
  usuarios   Usuario[]

  @@map("papeis")
}

/// Permissão concedida a um papel, no formato `recurso:acao`.
model PermissaoPapel {
  papelId   String @map("papel_id") @db.Uuid
  permissao String @db.VarChar(40)

  papel Papel @relation(fields: [papelId], references: [id], onDelete: Cascade)

  // Chave natural, como as demais tabelas filhas (ADR-0017).
  @@id([papelId, permissao])
  @@map("permissoes_papel")
}

model Usuario {
  id        String @id @db.Uuid
  /// Só dígitos, normalizada sem zeros à esquerda.
  matricula String @unique @db.VarChar(6)
  nome      String @db.VarChar(80)
  papelId   String @map("papel_id") @db.Uuid

  /// Hash Argon2id do PIN do balcão. NULL em quem não opera caixa.
  hashPin                 String? @map("hash_pin")
  algoritmoPin            String? @map("algoritmo_pin") @db.VarChar(20)
  /// Hash Argon2id da senha da retaguarda. NULL em quem só opera o PDV.
  hashSenha               String? @map("hash_senha")
  algoritmoSenha          String? @map("algoritmo_senha") @db.VarChar(20)
  /// Nunca existe senha padrão de fábrica: usuário novo nasce com `true`.
  precisaTrocarCredencial Boolean @default(true) @map("precisa_trocar_credencial")
  ativo                   Boolean @default(true)

  // Estado do bloqueio progressivo. Persistido para que reiniciar o servidor
  // não zere a proteção — seria a forma mais fácil de contorná-la.
  tentativasFalhas      Int       @default(0) @map("tentativas_falhas")
  bloqueadoAte          DateTime? @map("bloqueado_ate") @db.Timestamptz(3)
  bloqueiosConsecutivos Int       @default(0) @map("bloqueios_consecutivos")
  ultimoAcessoEm        DateTime? @map("ultimo_acesso_em") @db.Timestamptz(3)

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  papel    Papel              @relation(fields: [papelId], references: [id])
  estacoes EstacaoPermitida[]
  sessoes  SessaoAcesso[]

  sessoesDeCaixa           SessaoCaixa[]       @relation("SessaoCaixaOperador")
  vendasCanceladas         Venda[]             @relation("VendaCanceladaPor")
  cancelamentosAutorizados Venda[]             @relation("VendaCancelamentoAutorizadoPor")
  devolucoesRegistradas    Devolucao[]         @relation("DevolucaoUsuario")
  devolucoesAutorizadas    Devolucao[]         @relation("DevolucaoAutorizadaPor")
  registrosDeAuditoria     RegistroAuditoria[] @relation("AuditoriaUsuario")
  autorizacoesNaAuditoria  RegistroAuditoria[] @relation("AuditoriaAutorizadoPor")
  execucoesDeBackup        ExecucaoBackup[]

  @@index([papelId], map: "idx_usuarios_papel")
  @@map("usuarios")
}

/// Restrição de estação. Ausência de linhas significa **todas** as estações.
model EstacaoPermitida {
  usuarioId String @map("usuario_id") @db.Uuid
  estacaoId String @map("estacao_id") @db.Uuid

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, estacaoId])
  @@map("estacoes_permitidas")
}

enum ContextoSessao {
  PDV
  RETAGUARDA
}

/// Sessão de acesso. Guarda apenas o HASH do refresh — vazamento do banco não
/// entrega sessão ativa, porque hash não é aceito na renovação.
model SessaoAcesso {
  id               String         @id @db.Uuid
  usuarioId        String         @map("usuario_id") @db.Uuid
  /// Cadeia de renovações do mesmo login. É por ela que se revoga tudo de uma vez.
  familiaId        String         @map("familia_id") @db.Uuid
  dispositivoId    String         @map("dispositivo_id") @db.Uuid
  contexto         ContextoSessao
  hashRefresh      String         @map("hash_refresh")
  algoritmoRefresh String         @map("algoritmo_refresh") @db.VarChar(20)
  criadaEm         DateTime       @map("criada_em") @db.Timestamptz(3)
  expiraEm         DateTime       @map("expira_em") @db.Timestamptz(3)
  revogadaEm       DateTime?      @map("revogada_em") @db.Timestamptz(3)
  /// Quando o refresh foi gasto. Reaparecer depois disto é reúso.
  usadaEm          DateTime?      @map("usada_em") @db.Timestamptz(3)
  sucessoraId      String?        @map("sucessora_id") @db.Uuid

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // Revogar a família inteira é uma operação só, e precisa de índice.
  @@index([familiaId], map: "idx_sessoes_familia")
  @@index([usuarioId], map: "idx_sessoes_usuario")
  // O worker de limpeza remove as vencidas.
  @@index([expiraEm], map: "idx_sessoes_expiracao")
  @@map("sessoes_acesso")
}

// ── Cadastros de apoio ───────────────────────────────────────────────────

/// Categoria de produto. Plana de propósito (sem grupo/subgrupo).
model Categoria {
  id           String   @id @db.Uuid
  nome         String   @db.VarChar(60)
  /// Forma normalizada (sem acento, minúscula). É por aqui que a unicidade é
  /// garantida: "Bebidas" e "bebidas " dividiriam o faturamento em duas linhas
  /// do relatório sem que ninguém percebesse na tela.
  nomeBusca    String   @unique @map("nome_busca")
  ativa        Boolean  @default(true)
  /// Emoji do botão no caixa — "🍞 Pães". A foto, quando há, vence.
  icone        String?  @db.VarChar(16)
  imagemId     String?  @map("imagem_id") @db.Uuid
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  imagem Imagem? @relation(fields: [imagemId], references: [id])

  @@map("categorias")
}

model Cliente {
  id                String  @id @db.Uuid
  nome              String  @db.VarChar(120)
  apelido           String? @db.VarChar(60)
  nomeBusca         String  @map("nome_busca")
  tipoPessoa        String  @map("tipo_pessoa") @db.VarChar(10)
  /// Só os dígitos. Opcional por minimização da LGPD: a padaria que anota o
  /// fiado não precisa do CPF de quem compra.
  documento         String? @unique @db.VarChar(14)
  inscricaoEstadual String? @map("inscricao_estadual") @db.VarChar(20)
  telefone          String? @db.VarChar(11)
  email             String? @db.VarChar(160)
  /// Centavos. Zero significa "não vende a prazo".
  limiteCredito     BigInt  @default(0) @map("limite_credito")
  observacao        String? @db.VarChar(500)
  ativo             Boolean @default(true)

  logradouro          String? @db.VarChar(120)
  numero              String? @db.VarChar(10)
  complemento         String? @db.VarChar(60)
  bairro              String? @db.VarChar(60)
  municipio           String? @db.VarChar(60)
  codigoMunicipioIbge String? @map("codigo_municipio_ibge") @db.VarChar(7)
  uf                  String? @db.VarChar(2)
  cep                 String? @db.VarChar(8)

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  // A busca da retaguarda filtra por ativo e ordena por nome; sem o índice
  // parcial, uma loja com dez mil clientes varre a tabela a cada tecla.
  @@index([nomeBusca(ops: raw("text_pattern_ops"))], map: "ix_cliente_nome_busca", type: BTree)
  @@map("clientes")
}

/// A empresa que opera esta instalação.
///
/// **Uma linha, sempre** (ADR-0024). A garantia não é convenção: `unica` é uma
/// coluna com valor fixo e índice único, então a segunda inserção falha no
/// banco. Confiar só no código deixaria a porta aberta para o dia em que um
/// caminho novo esquecer de conferir — e duas empresas na mesma instalação
/// fariam todo relatório somar dois cabeçalhos diferentes.
model Empresa {
  id                 String  @id @db.Uuid
  razaoSocial        String  @map("razao_social") @db.VarChar(60)
  nomeFantasia       String? @map("nome_fantasia") @db.VarChar(60)
  razaoSocialBusca   String  @map("razao_social_busca")
  /// Só CNPJ: quem emite documento fiscal não emite com CPF.
  cnpj               String  @unique @db.VarChar(14)
  inscricaoEstadual  String? @map("inscricao_estadual") @db.VarChar(20)
  inscricaoMunicipal String? @map("inscricao_municipal") @db.VarChar(20)
  regimeTributario   String  @map("regime_tributario") @db.VarChar(30)
  telefone           String? @db.VarChar(11)
  email              String? @db.VarChar(160)

  /// Endereço **obrigatório**: é o do emitente, e vai no cupom e na nota.
  logradouro          String  @db.VarChar(120)
  numero              String  @db.VarChar(10)
  complemento         String? @db.VarChar(60)
  bairro              String  @db.VarChar(60)
  municipio           String  @db.VarChar(60)
  codigoMunicipioIbge String? @map("codigo_municipio_ibge") @db.VarChar(7)
  uf                  String  @db.VarChar(2)
  cep                 String  @db.VarChar(8)

  /// Sempre `true`. Existe só para o índice único garantir a linha única.
  unica Boolean @unique @default(true)

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@map("empresas")
}

model Fornecedor {
  id                String  @id @db.Uuid
  razaoSocial       String  @map("razao_social") @db.VarChar(120)
  nomeFantasia      String? @map("nome_fantasia") @db.VarChar(60)
  razaoSocialBusca  String  @map("razao_social_busca")
  /// **Obrigatório**, ao contrário do cliente: toda entrada de mercadoria chega
  /// com nota, e a nota traz o documento do emitente.
  documento         String  @unique @db.VarChar(14)
  inscricaoEstadual String? @map("inscricao_estadual") @db.VarChar(20)
  telefone          String? @db.VarChar(11)
  email             String? @db.VarChar(160)
  prazoEntregaDias  Int?    @map("prazo_entrega_dias")
  observacao        String? @db.VarChar(500)
  ativo             Boolean @default(true)

  logradouro          String? @db.VarChar(120)
  numero              String? @db.VarChar(10)
  complemento         String? @db.VarChar(60)
  bairro              String? @db.VarChar(60)
  municipio           String? @db.VarChar(60)
  codigoMunicipioIbge String? @map("codigo_municipio_ibge") @db.VarChar(7)
  uf                  String? @db.VarChar(2)
  cep                 String? @db.VarChar(8)

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  notasDeCompra NotaDeCompra[]
  produtos      Produto[]

  @@index([razaoSocialBusca(ops: raw("text_pattern_ops"))], map: "ix_fornecedor_razao_busca", type: BTree)
  @@map("fornecedores")
}

/// Vendas que chegaram da fila offline de uma estação.
///
/// Existe para uma coisa só: **reenviar não pode duplicar**. A resposta do
/// servidor pode se perder depois de ele ter gravado a venda, e sem esta tabela
/// o reenvio criaria uma segunda — o fechamento acusaria dinheiro que não
/// existe, e ninguém saberia de onde veio.
model VendaImportada {
  /// Identificador gerado na estação, antes de qualquer ida ao servidor.
  chave     String   @id @db.VarChar(64)
  vendaId   String   @unique @map("venda_id") @db.Uuid
  estacaoId String   @map("estacao_id") @db.Uuid
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  venda Venda @relation(fields: [vendaId], references: [id], onDelete: Restrict)

  @@index([estacaoId, criadoEm], map: "ix_venda_importada_estacao")
  @@map("vendas_importadas")
}

enum StatusNotaCompra {
  LANCADA
  CANCELADA
}

/// Nota de entrada de mercadoria.
///
/// É o documento que responde de onde veio o estoque. Os movimentos apontam
/// para ela por `origem_documento_id`, e é essa corrente — saldo → movimento →
/// nota → fornecedor — que permite conferir uma divergência de inventário sem
/// passo faltando.
model NotaDeCompra {
  id                 String           @id @db.Uuid
  fornecedorId       String           @map("fornecedor_id") @db.Uuid
  numero             String           @db.VarChar(20)
  /// Vazio significa "sem série", e **não** nulo: no PostgreSQL dois `NULL` são
  /// distintos, e o índice único deixaria passar a mesma nota duas vezes —
  /// justamente o defeito que ele existe para impedir.
  serie              String           @default("") @db.VarChar(5)
  emitidaEm          DateTime         @map("emitida_em") @db.Timestamptz(3)
  recebidaEm         DateTime         @map("recebida_em") @db.Timestamptz(3)
  /// Centavos — total impresso na nota, guardado para conferência de digitação.
  totalDeclarado     BigInt           @map("total_declarado")
  usuarioId          String           @map("usuario_id") @db.Uuid
  observacao         String?          @db.VarChar(500)
  status             StatusNotaCompra @default(LANCADA)
  canceladaEm        DateTime?        @map("cancelada_em") @db.Timestamptz(3)
  motivoCancelamento String?          @map("motivo_cancelamento") @db.VarChar(500)
  criadoEm           DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)

  fornecedor Fornecedor       @relation(fields: [fornecedorId], references: [id])
  itens      ItemNotaCompra[]

  /// A unicidade de fornecedor + número + série é **parcial**: vale só para as
  /// notas `LANCADA`. Está em SQL cru na migração porque o Prisma não declara
  /// índice parcial no esquema.
  ///
  /// Parcial, e não total, por um caso concreto: quem digitou a quantidade
  /// errada cancela a nota e precisa relançá-la com o mesmo número. Com índice
  /// total, a chave ficaria presa pela nota cancelada e a correção seria
  /// impossível sem mexer no banco.
  @@index([fornecedorId, numero, serie], map: "idx_notas_fornecedor_numero_serie")
  @@index([recebidaEm], map: "idx_notas_recebida")
  @@map("notas_compra")
}

model ItemNotaCompra {
  notaId        String @map("nota_id") @db.Uuid
  /// Sequencial dentro da nota.
  numero        Int
  produtoId     String @map("produto_id") @db.Uuid
  /// Congelada no lançamento — renomear o produto não reescreve a nota.
  descricao     String @db.VarChar(120)
  /// Milésimos, na unidade em que a mercadoria chegou.
  quantidade    BigInt
  unidade       String @db.VarChar(6)
  /// Centavos, por unidade **da nota** — não da unidade base do produto.
  custoUnitario BigInt @map("custo_unitario")
  /// Centavos — desconto dado nesta linha pelo fornecedor.
  desconto      BigInt @default(0)

  nota    NotaDeCompra @relation(fields: [notaId], references: [id], onDelete: Cascade)
  produto Produto      @relation(fields: [produtoId], references: [id])

  // Chave natural: o item só existe dentro da nota e não tem identidade própria.
  @@id([notaId, numero])
  @@index([produtoId], map: "idx_itens_nota_produto")
  @@map("itens_nota_compra")
}

/// Título a receber ou a pagar.
///
/// É a caderneta do lojista — o fiado que hoje mora num caderno e é onde o dono
/// mais perde dinheiro (`ANALISE-SEGMENTOS.md` §3.3).
///
/// **Não há coluna de saldo nem de situação.** As duas são derivadas das baixas
/// (princípio 5): saldo é o valor original menos a soma delas, e a situação sai
/// do saldo. Guardar qualquer uma criaria um segundo lugar onde a verdade mora,
/// e no dia em que discordassem ninguém saberia qual está certa.
model Titulo {
  id     String       @id @db.Uuid
  tipo   TipoTitulo
  origem OrigemTitulo

  /// Venda ou nota de compra que o gerou. Nulo quando lançado à mão.
  ///
  /// Sem chave estrangeira de propósito: aponta para **duas** tabelas
  /// diferentes conforme a origem, e o PostgreSQL não tem FK polimórfica. A
  /// integridade é garantida no caso de uso, que só grava o id de um documento
  /// que acabou de ler.
  documentoId String? @map("documento_id") @db.Uuid

  /// Cliente (a receber) ou fornecedor (a pagar). Nulo na conta de luz, que não
  /// tem cadastro — exigi-lo faria o lojista cadastrar a concessionária.
  contraparteId   String? @map("contraparte_id") @db.Uuid
  /// Congelado no lançamento: renomear o cliente não reescreve a caderneta.
  contraparteNome String  @map("contraparte_nome") @db.VarChar(120)

  /// Centavos. Nunca muda — o que muda é quanto já foi baixado.
  valorOriginal BigInt   @map("valor_original")
  vencimento    DateTime @db.Timestamptz(3)
  emitidoEm     DateTime @map("emitido_em") @db.Timestamptz(3)

  /// `2 de 6` no carnê. Nulos no título único: `1 de 1` seria ruído.
  parcelaNumero Int? @map("parcela_numero")
  parcelaDe     Int? @map("parcela_de")

  descricao String? @db.VarChar(200)

  canceladoEm        DateTime? @map("cancelado_em") @db.Timestamptz(3)
  motivoCancelamento String?   @map("motivo_cancelamento") @db.VarChar(500)

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  baixas BaixaTitulo[]

  /// Cobre a pergunta do balcão — "quanto o seu José deve?" — e a da tela de
  /// cobrança, que lista por vencimento.
  @@index([tipo, contraparteId], map: "idx_titulos_tipo_contraparte")
  @@index([tipo, vencimento], map: "idx_titulos_tipo_vencimento")
  @@index([documentoId], map: "idx_titulos_documento")
  @@map("titulos")
}

/// Um lançamento no título: recebimento ou estorno.
///
/// **Append-only.** Corrigir um recebimento errado grava um `ESTORNO`, nunca um
/// `UPDATE` — o cliente que pagou R$ 50 e viu o valor sumir do extrato não
/// confia mais na caderneta do sistema do que confiava na de papel. Um gatilho
/// no banco recusa `UPDATE` e `DELETE`, como em `movimentos_estoque`.
model BaixaTitulo {
  id       String    @id @db.Uuid
  tituloId String    @map("titulo_id") @db.Uuid
  tipo     TipoBaixa

  /// Centavos. No estorno, repete o valor da baixa que ele desfaz.
  valor      BigInt
  ocorridaEm DateTime @map("ocorrida_em") @db.Timestamptz(3)
  usuarioId  String   @map("usuario_id") @db.Uuid
  /// Como o dinheiro entrou. Nulo no estorno.
  forma      String?  @db.VarChar(30)
  observacao String?  @db.VarChar(500)
  /// Preenchido no estorno: qual recebimento ele desfaz.
  estornaId  String?  @map("estorna_id") @db.Uuid

  titulo Titulo @relation(fields: [tituloId], references: [id], onDelete: Cascade)

  /// Um recebimento só é estornado uma vez. Sem isto, dois cliques no botão
  /// devolveriam o dobro ao saldo e a dívida do cliente cresceria sozinha.
  @@unique([estornaId], map: "uq_baixa_estorno_unico")
  @@index([tituloId, ocorridaEm], map: "idx_baixas_titulo_data")
  @@map("baixas_titulo")
}

enum TipoTitulo {
  RECEBER
  PAGAR
}

enum OrigemTitulo {
  VENDA
  COMPRA
  MANUAL
}

enum TipoBaixa {
  PAGAMENTO
  ESTORNO
}

// ─────────────────────────────────────────────────────────────────────────
// Balcão completo — configuração, devolução, auditoria, imagens e backup
// ─────────────────────────────────────────────────────────────────────────

/// Como a loja vende. **Uma linha** por instalação, como a empresa (ADR-0024).
///
/// Os valores enumerados ficam em texto com CHECK na migração, como `forma` em
/// `pagamentos`: o domínio fecha a lista, e um enum do PostgreSQL só cresceria
/// com `ALTER TYPE`, que não se desfaz numa reversão.
model ConfiguracaoLoja {
  id                   String   @id @db.Uuid
  segmento             String   @db.VarChar(12)
  recursos             String[]
  vendaSemEstoque      String   @default("PERMITIR") @map("venda_sem_estoque") @db.VarChar(10)
  larguraCupom         Int      @default(80) @map("largura_cupom")
  impressaoComprovante String   @default("SEMPRE") @map("impressao_comprovante") @db.VarChar(10)
  balancaPrefixos      String[] @default(["2"]) @map("balanca_prefixos")
  balancaTamanhoCodigo Int      @default(6) @map("balanca_tamanho_codigo")
  balancaConteudo      String   @default("PESO") @map("balanca_conteudo") @db.VarChar(5)
  balancaCasasDecimais Int      @default(3) @map("balanca_casas_decimais")
  /// Sempre `true`. Existe só para o índice único garantir a linha única.
  unica                Boolean  @unique @default(true)
  criadoEm             DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm         DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@map("configuracao_loja")
}

/// Devolução de mercadoria, ligada à venda original. **Append-only**: devolução
/// errada se corrige com outra operação, nunca reescrevendo esta.
model Devolucao {
  id              String   @id @db.Uuid
  vendaId         String   @map("venda_id") @db.Uuid
  /// Congelado: é o número que o cliente leu no cupom.
  numeroVenda     Int      @map("numero_venda")
  formaReembolso  String   @map("forma_reembolso") @db.VarChar(12)
  motivo          String   @db.VarChar(200)
  usuarioId       String   @map("usuario_id") @db.Uuid
  autorizadoPorId String?  @map("autorizado_por_id") @db.Uuid
  /// Caixa de onde saiu o dinheiro. NULL quando o reembolso não passou pela gaveta.
  sessaoCaixaId   String?  @map("sessao_caixa_id") @db.Uuid
  ocorridaEm      DateTime @map("ocorrida_em") @db.Timestamptz(3)

  venda         Venda           @relation(fields: [vendaId], references: [id])
  usuario       Usuario         @relation("DevolucaoUsuario", fields: [usuarioId], references: [id])
  autorizadoPor Usuario?        @relation("DevolucaoAutorizadaPor", fields: [autorizadoPorId], references: [id], onDelete: Restrict)
  sessao        SessaoCaixa?    @relation(fields: [sessaoCaixaId], references: [id], onDelete: Restrict)
  itens         DevolucaoItem[]

  @@index([vendaId], map: "idx_devolucoes_venda")
  @@index([sessaoCaixaId], map: "idx_devolucoes_sessao")
  @@index([ocorridaEm], map: "idx_devolucoes_data")
  @@map("devolucoes")
}

model DevolucaoItem {
  devolucaoId String @map("devolucao_id") @db.Uuid
  /// Número do item **na venda original**.
  numeroItem  Int    @map("numero_item")
  produtoId   String @map("produto_id") @db.Uuid
  descricao   String @db.VarChar(120)
  /// Milésimos.
  quantidade  BigInt
  unidade     String @db.VarChar(6)
  /// Centavos — o que este item devolveu, já com os descontos que teve.
  valor       BigInt
  /// ESTOQUE ou PERDA. CHECK na migração.
  destino     String @db.VarChar(8)

  devolucao Devolucao @relation(fields: [devolucaoId], references: [id], onDelete: Cascade)
  produto   Produto   @relation(fields: [produtoId], references: [id])

  @@id([devolucaoId, numeroItem])
  @@index([produtoId], map: "idx_devolucao_itens_produto")
  @@map("devolucao_itens")
}

/// Quem fez o quê no que mexe com dinheiro, estoque e preço. **Append-only**,
/// gravado na mesma transação da operação: auditoria que pode faltar não prova
/// nada.
model RegistroAuditoria {
  id              String   @id @db.Uuid
  ocorridoEm      DateTime @map("ocorrido_em") @db.Timestamptz(3)
  acao            String   @db.VarChar(40)
  /// NULL nas ações do próprio sistema, como o backup agendado.
  usuarioId       String?  @map("usuario_id") @db.Uuid
  autorizadoPorId String?  @map("autorizado_por_id") @db.Uuid
  /// Escrita para o dono ler: "Desconto de R$ 2,00 (10%) no item 3 da venda 47".
  descricao       String   @db.VarChar(300)
  entidade        String?  @db.VarChar(30)
  entidadeId      String?  @map("entidade_id") @db.Uuid
  /// Detalhes para diagnóstico. Dinheiro vai como texto de centavos.
  dados           Json?

  usuario       Usuario? @relation("AuditoriaUsuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  autorizadoPor Usuario? @relation("AuditoriaAutorizadoPor", fields: [autorizadoPorId], references: [id], onDelete: Restrict)

  @@index([ocorridoEm], map: "idx_auditoria_data")
  @@index([acao, ocorridoEm], map: "idx_auditoria_acao_data")
  @@index([usuarioId, ocorridoEm], map: "idx_auditoria_usuario_data")
  @@index([entidadeId], map: "idx_auditoria_entidade")
  @@map("registros_auditoria")
}

/// Foto de produto, de categoria ou o logotipo da loja.
///
/// No banco, e não em pasta, para que o backup leve tudo num arquivo só: a
/// restauração que devolve as vendas e esquece as fotos é a que o lojista só
/// descobre quando o caixa abre sem botões.
model Imagem {
  id       String   @id @db.Uuid
  /// image/png, image/jpeg ou image/webp — conferido pelos bytes, não pelo nome.
  tipo     String   @db.VarChar(20)
  conteudo Bytes
  bytes    Int
  /// SHA-256: a mesma foto enviada duas vezes vira uma imagem só.
  hash     String   @unique @db.VarChar(64)
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  produtos   Produto[]
  categorias Categoria[]

  @@map("imagens")
}

/// Agenda e destino do backup. **Uma linha** por instalação.
model ConfiguracaoBackup {
  id             String   @id @db.Uuid
  /// NULL usa a pasta padrão da instalação.
  pasta          String?  @db.VarChar(260)
  /// De quantas em quantas horas. Zero desliga o agendamento.
  intervaloHoras Int      @default(24) @map("intervalo_horas")
  aoFecharCaixa  Boolean  @default(true) @map("ao_fechar_caixa")
  /// Quantos arquivos guardar. Os mais antigos saem.
  manterUltimos  Int      @default(30) @map("manter_ultimos")
  unica          Boolean  @unique @default(true)
  atualizadoEm   DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@map("configuracao_backup")
}

/// Cada tentativa de backup ou restauração — inclusive as que falharam.
///
/// É o que o suporte lê remotamente quando o lojista diz "acho que o backup não
/// está funcionando", e o que a tela mostra como "último backup: ontem, 23h".
model ExecucaoBackup {
  id          String    @id @db.Uuid
  /// BACKUP ou RESTAURACAO.
  operacao    String    @db.VarChar(12)
  /// MANUAL, AGENDADO ou FECHAMENTO.
  origem      String    @db.VarChar(12)
  /// EM_ANDAMENTO, CONCLUIDO ou FALHOU.
  situacao    String    @db.VarChar(14)
  arquivo     String?   @db.VarChar(260)
  bytes       BigInt?
  hash        String?   @db.VarChar(64)
  erro        String?   @db.VarChar(500)
  usuarioId   String?   @map("usuario_id") @db.Uuid
  iniciadaEm  DateTime  @map("iniciada_em") @db.Timestamptz(3)
  concluidaEm DateTime? @map("concluida_em") @db.Timestamptz(3)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([iniciadaEm], map: "idx_execucoes_backup_data")
  @@map("execucoes_backup")
}
