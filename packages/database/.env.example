# Copie para `.env` — que é ignorado pelo git — e ajuste se precisar.
#
# Estas variáveis servem ao desenvolvimento e ao CI. Em produção a URL vem da
# configuração da instalação, nunca de arquivo versionado (CLAUDE.md §7).

# Banco de desenvolvimento, criado por `pnpm db:up`.
DATABASE_URL="postgresql://erp:erp_dev_only@localhost:55432/erp_pdv"

# Banco da suíte de integração. Separado do de desenvolvimento de propósito:
# os testes truncam as tabelas entre casos.
DATABASE_URL_TESTE="postgresql://erp:erp_dev_only@localhost:55432/erp_teste"
