{
  "name": "@erp/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Persistência PostgreSQL — implementa as portas de @erp/application",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json && node scripts/copiar-gerado.mjs",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "prisma generate && eslint src",
    "test": "prisma generate && vitest run",
    "test:cov": "prisma generate && vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@erp/application": "workspace:*",
    "@erp/domain": "workspace:*",
    "@erp/utils": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.1"
  },
  "devDependencies": {
    "@erp/config": "workspace:*",
    "prisma": "^6.19.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
