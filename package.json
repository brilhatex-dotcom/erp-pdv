{
  "name": "erp-pdv",
  "version": "0.0.0",
  "private": true,
  "description": "ERP + PDV para pequenos e médios estabelecimentos brasileiros",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch": "depcruise packages apps --config .dependency-cruiser.cjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm arch && pnpm test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "devDependencies": {
    "@erp/config": "workspace:*",
    "@types/node": "^22.18.6",
    "@vitest/coverage-v8": "^3.2.4",
    "dependency-cruiser": "^17.0.1",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4"
  }
}
