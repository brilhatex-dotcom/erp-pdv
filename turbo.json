{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",

  // O Turborepo 2 roda as tarefas em ambiente **estrito**: só as variáveis
  // declaradas aqui chegam ao processo filho. Não declarar é como o CI falha de
  // um jeito difícil de entender — a suíte de integração não recebe a URL do
  // banco de teste, cai no valor padrão de desenvolvimento e acusa "banco fora
  // do ar" numa máquina onde o banco está no ar.
  //
  // **Suíte nova com banco próprio precisa declarar a variável dela aqui.**
  // O `apps/server` usa `DATABASE_URL_TESTE_API`, e esquecê-la custou uma
  // reprovação de CI: no desenvolvimento o valor padrão aponta para a porta
  // certa e nada acusa; no CI, a porta é outra e a suíte não alcança o banco.
  "globalEnv": ["NODE_ENV"],

  // Repassadas sem entrar no hash: dizem **como** alcançar a rede, não o que
  // construir. Sem elas, o `prisma generate` atrás de proxy corporativo falha na
  // verificação de certificado — e mudar de rede não deve invalidar o cache.
  "globalPassThroughEnv": [
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY",
    "NODE_EXTRA_CA_CERTS"
  ],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["DATABASE_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["DATABASE_URL"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["DATABASE_URL"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["DATABASE_URL", "DATABASE_URL_TESTE", "DATABASE_URL_TESTE_API"]
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["DATABASE_URL", "DATABASE_URL_TESTE", "DATABASE_URL_TESTE_API"]
    }
  }
}
