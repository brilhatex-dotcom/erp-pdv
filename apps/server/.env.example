# Configuração do servidor. Copie para `.env` — que é ignorado pelo git.
#
# Em produção estes valores vêm da configuração da instalação, nunca de arquivo
# versionado (CLAUDE.md §7). Só `DATABASE_URL` é obrigatória; as demais têm
# padrão seguro e o servidor recusa subir com valor inválido.

# Banco de desenvolvimento, criado por `pnpm db:up`.
DATABASE_URL="postgresql://erp:erp_dev_only@localhost:55432/erp_pdv"

# Endereço de escuta. O padrão `127.0.0.1` atende SÓ esta máquina; expor o
# servidor às estações da loja é decisão consciente de quem instala.
# SERVIDOR_ENDERECO="0.0.0.0"
# SERVIDOR_PORTA="3000"

# fatal | error | warn | info | debug | trace | silent
# NIVEL_LOG="info"

# Registra cada consulta SQL. Só para diagnóstico: enche o disco da loja.
# REGISTRAR_CONSULTAS_SQL="false"

# Teto por origem. O padrão é generoso: um caixa em hora de pico faz poucas
# dezenas de requisições por minuto, e limite apertado recusaria venda.
# LIMITE_REQUISICOES_POR_MINUTO="600"

# Quanto esperar pelas requisições em curso antes de encerrar à força.
# TEMPO_LIMITE_ENCERRAMENTO_MS="10000"
